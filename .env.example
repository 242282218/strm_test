# Smart Media Environment Variables Configuration
# Copy this file to .env and fill in your values
# Priority: Environment Variable > config.yaml value

# Runtime image (built in GitHub Actions and pushed to GHCR)
QUARK_STRM_IMAGE=ghcr.io/242282218/smart_media/quark-strm:latest

SMART_MEDIA_EMBY_PROXY_PORT=18097
SMART_MEDIA_LOG_FORMAT=json
SMART_MEDIA_LOG_LEVEL=INFO
TZ=Asia/Shanghai
SMART_MEDIA_AI_API_KEY=
SMART_MEDIA_TMDB_API_KEY=

# ============================================
# Quark Cloud Drive (Required for Quark features)
# ============================================
SMART_MEDIA_QUARK_COOKIE=

# ============================================
# Emby Integration
# ============================================
SMART_MEDIA_EMBY_URL=
SMART_MEDIA_EMBY_PROXY_BASE_URL=
SMART_MEDIA_EMBY_API_KEY=

# ============================================
# AI Providers (Choose one or more)
# ============================================
SMART_MEDIA_ZHIPU_API_KEY=
SMART_MEDIA_DEEPSEEK_API_KEY=
SMART_MEDIA_GLM_API_KEY=
SMART_MEDIA_KIMI_API_KEY=

# ============================================
# Telegram Notifications
# ============================================
SMART_MEDIA_TELEGRAM_BOT_TOKEN=
SMART_MEDIA_TELEGRAM_CHAT_ID=
SMART_MEDIA_TELEGRAM_PROXY=

# ============================================
# WebDAV (For fallback playback)
# ============================================
SMART_MEDIA_WEBDAV_USERNAME=
SMART_MEDIA_WEBDAV_PASSWORD=

# ============================================
# AList Integration
# ============================================
SMART_MEDIA_ALIST_TOKEN=

# ============================================
# WeChat Notifications
# ============================================
SMART_MEDIA_WECHAT_SEND_KEY=

# ============================================
# Security (API protection)
# ============================================
SMART_MEDIA_SECURITY_API_KEY=
SMART_MEDIA_JWT_SECRET_KEY=
